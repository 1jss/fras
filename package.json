{
  "name": "fras",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A specialized Swedish phonetizer for Piper: phonetize a whole utterance with a pronunciation lexicon plus Swedish letter-to-sound rules, emitting the phoneme inventory the Swedish voices were trained on.",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "fras": "src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist", "data"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "setup": "node tools/setup.ts",
    "frequency": "node tools/build-pos-frequency.ts",
    "build:braxen:lexicon": "node tools/build-braxen-lexicon.ts",
    "merge:lexicon": "node tools/merge-lexicon.ts",
    "prune:write": "node tools/prune-lexicon.ts --write --all --min-freq 0.01 --full-words-only",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
